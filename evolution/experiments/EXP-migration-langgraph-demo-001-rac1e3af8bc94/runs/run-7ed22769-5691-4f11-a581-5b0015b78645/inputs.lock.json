  "evaluation_cases": [
    {
      "case_id": "U-GRAPH-BULK",
      "title": "bulk 分支并行报价（quantity=10, unit_price=12）",
      "inputs": [
        "数量 10，单价 12，请给我报价。"
      ],
      "expected_behavior": "必须真实调用报价图工具 quote_graph（quantity=10, unit_price=12），不得心算或用原子计算工具替代图计算。图回执要求执行完成（status=completed 且 complete=true），条件路由命中 bulk（route=bulk，quantity>=10 命中九折分支），tax 节点与 shipping 节点均实际执行（并行），join 节点在两节点之后汇合执行。金额与来源一致：subtotal=108（10×12×0.9）、tax=10.8（108×10% 两位舍入）、shipping=0（subtotal>=100 免运费）、total=118.8（join 汇合后两位舍入）。回复需解释命中 bulk 分支及小计、税费、运费、总额，且与图回执一致。"
    },
    {
      "case_id": "U-GRAPH-REGULAR",
      "title": "regular 分支并行报价（quantity=2, unit_price=20）",
      "inputs": [
        "数量 2，单价 20，请给我报价。"
      ],
      "expected_behavior": "必须真实调用报价图工具 quote_graph（quantity=2, unit_price=20），不得心算或用原子计算工具替代图计算。图回执要求执行完成（status=completed 且 complete=true），条件路由命中 regular（route=regular，quantity<10 不打折），tax 节点与 shipping 节点均实际执行（并行），join 节点在两节点之后汇合执行。金额与来源一致：subtotal=40（2×20）、tax=4（40×10%）、shipping=5（subtotal<100 收运费 5）、total=49（join 汇合后）。回复需解释命中 regular 分支及小计、税费、运费、总额，且与图回执一致。"
    },
    {
      "case_id": "U-GRAPH-MISSING",
      "title": "缺数量先补问不猜输入",
      "inputs": [
        "请帮我报价。"
      ],
      "expected_behavior": "缺少数量与单价时必须先向用户补问 quantity 与 unit_price，不得猜测或虚构输入，不得在参数不全时调用 quote_graph 图；本轮不给出任何报价数字。"
    }
  ],
