{
  "name": "dsh-security-report-download",
  "version": "0.1.0",
  "description": "Preview and download verified security reports from the current session.",
  "private": true,
  "type": "module",
  "main": "./index.mjs",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.mjs", "client.js", "locale/*.json", "icon.svg", "LICENSE"],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
