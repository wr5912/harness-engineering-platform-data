  "evaluation_cases": [
    {
      "case_id": "U-VERSION-COMPARE",
      "title": "比较 1.9 与 1.10 并经 Python 工具给出较新版本",
      "inputs": [
        "比较 1.9 和 1.10，哪个版本更新？"
      ],
      "expected_behavior": "必须调用 select_newer_version 工具（left=1.9、right=1.10），工具经 Python3 实际执行返回 newer=1.10；回答应明确 1.10 较新（注意 1.10 > 1.9 的语义比较，不是字符串比较），依据工具回执，不自行猜测。"
    },
    {
      "case_id": "U-VERSION-INVALID",
      "title": "无效版本输入时说明工具错误，不捏造较新版本",
      "inputs": [
        "比较 not-a-version 和 1.0，哪个版本更新？"
      ],
      "expected_behavior": "必须调用 select_newer_version 工具；Python 工具实际执行报错（InvalidVersion，非零退出）后，回答如实说明输入无效/工具报错，绝不给出或捏造较新版本。"
    },
    {
      "case_id": "U-VERSION-MISSING",
      "title": "只给一个版本时先补问另一个版本",
      "inputs": [
        "帮我看看 2.0 是不是比较新的版本？"
      ],
      "expected_behavior": "用户只提供了一个版本，缺少可比较的第二个版本；应先补问另一个版本再比较，不调用 select_newer_version，不猜测比较结果。"
    }
  ],
