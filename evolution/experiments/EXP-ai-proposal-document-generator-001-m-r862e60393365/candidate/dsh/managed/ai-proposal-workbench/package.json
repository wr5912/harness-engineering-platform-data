{
  "name": "@business/ai-proposal-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "AI方案文档生成智能体的原生 DSH Web 方案工作台",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-cordis-client-runner", "@deepseek-ai/dsh-client-ui-layout"]
    }
  },
  "meta": {
    "title": "方案工作台",
    "description": "在 DSH 原生 Web 壳内显示方案文档、要求、证据、评审和发布门禁工作台。"
  },
  "scripts": {
    "verify": "node tools/verify-client.mjs"
  },
  "files": ["lib/**/*.js", "tools/*.mjs", "tools/*.py", "cordis.patch.yml", "README.md", "PROVENANCE.md", "package.json"]
}
