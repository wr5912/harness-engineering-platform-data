{
  "name": "@eaglezlee/dsh-ui-html",
  "version": "0.1.0",
  "private": true,
  "description": "在 DSH 对话中渲染沙箱化的交互式 HTML 界面，并把用户的操作结构化送回模型（默认作为新的用户消息，阻塞模式下作为工具结果）",
  "type": "module",
  "main": "lib/index.js",
  "author": "eaglezlee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eaglezlee/dsh-ui-html.git"
  },
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "meta": {
    "title": "交互式 HTML 界面",
    "description": "让模型在对话中渲染沙箱化 HTML 界面，并把用户的点击/选择/表单提交结构化送回模型（默认为一条新的用户消息）。"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "react": "^18.2.0"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "files": [
    "lib/**/*.js",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ]
}
