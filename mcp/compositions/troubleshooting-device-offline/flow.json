              "code": {
                "type": "code",
                "name": "code",
                "value": "from hep_lfx import HepComponent, payload\nfrom lfx.io import DataInput, Output\nfrom lfx.schema import Data\nclass DiagnosticGate(HepComponent):\n inputs=[DataInput(name='value',required=True)]\n outputs=[Output(name='sufficient',method='route_sufficient',group_outputs=True,allows_loop=True,cache=False),Output(name='rule',method='route_rule',group_outputs=True,allows_loop=True,cache=False),Output(name='proposal',method='route_proposal',group_outputs=True,allows_loop=True,cache=False),Output(name='stop',method='route_stop',group_outputs=True,allows_loop=True,cache=False)]\n def choose(self):\n  selected=payload(self.value).get('route','stop')\n  excluded=[name for name in ('sufficient','rule','proposal','stop') if name!=selected]\n  for name in excluded:self.stop(name)\n  self.graph.exclude_branches_conditionally(self._id,excluded)\n  return self.value\n async def route_sufficient(self)->Data:return self.choose()\n async def route_rule(self)->Data:return self.choose()\n async def route_proposal(self)->Data:return self.choose()\n async def route_stop(self)->Data:return self.choose()\n"
              }
            },
            "base_classes": [
              "Data"
