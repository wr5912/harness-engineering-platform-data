                "multiline": true,
                "value": "from hep_lfx import HepComponent, component, payload\nfrom lfx.io import DataInput, Output\nfrom lfx.schema import Data\nclass HepSummary(HepComponent):\n display_name='汇总全面巡检结果'\n inputs=[DataInput(name='check_routine', display_name='check_routine', required=True),DataInput(name='check_vulnerabilities', display_name='check_vulnerabilities', required=True)]\n outputs=[Output(name=\"result\",display_name=\"结果\",method=\"build\")]\n async def build(self)->Data:\n  return Data(data=await component(\"summary\",{\"routine\":payload(self.check_routine),\"vulnerabilities\":payload(self.check_vulnerabilities)},self._id))\n",
